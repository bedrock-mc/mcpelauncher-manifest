# This should most probably benefit from getting a "Requires:" field added
# dynamically by configure.
#
prefix=/Users/hashim/Coding/other/mcpelauncher-manifest/build-macos/ext/curl
exec_prefix=${prefix}
libdir=/Users/hashim/Coding/other/mcpelauncher-manifest/build-macos/ext/curl/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS MQTT POP3 POP3S RTSP SMTP SMTPS TELNET TFTP WS WSS"
supported_features="SSL IPv6 unixsockets libz AsynchDNS Largefile alt-svc HSTS HTTPS-proxy threadsafe"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with ftp, http, etc.
Version: 8.0.1
Libs: -L${libdir} -lcurl  -framework SystemConfiguration -framework Security -framework CoreFoundation /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib/libz.tbd
Libs.private:  -framework SystemConfiguration -framework Security -framework CoreFoundation /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib/libz.tbd
Cflags: -I${includedir} 
